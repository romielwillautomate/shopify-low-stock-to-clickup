# Shopify store: the .myshopify.com address, not a custom domain
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Shopify access, option A (apps made in the Dev Dashboard since 2026): client ID and secret.
# The workflow gets a fresh 24 hour token on every run. Scopes: read_products, read_inventory.
SHOPIFY_CLIENT_ID=your-client-id
SHOPIFY_CLIENT_SECRET=your-client-secret
# Shopify access, option B (custom apps made in the Shopify admin before 2026): the Admin API token.
# Leave empty when you use option A.
SHOPIFY_ACCESS_TOKEN=

# Optional, defaults shown
SHOPIFY_API_VERSION=2026-10
SHOPIFY_PAGE_SIZE=100
SHOPIFY_VARIANT_QUERY=product_status:ACTIVE
REORDER_POINT_METAFIELD=custom.reorder_point
DEFAULT_REORDER_POINT=5
DEFAULT_LEAD_TIME_DAYS=14

# Optional: suppliers by exact SKU, SKU prefix ending in *, Shopify vendor name, or "default". One line of JSON.
SUPPLIERS_JSON={"Harbor Ceramics": {"name": "Harbor Ceramics Co.", "email": "orders@harborceramics.example.com", "leadTimeDays": 21}, "PLANT-*": {"name": "Greenline Pottery", "email": "sales@greenline.example.com", "leadTimeDays": 7}, "default": {"name": "Driftwood Wholesale", "email": "buying@driftwood-wholesale.example.com"}}

# ClickUp (avatar → Settings → Apps → API Token). The list ID is the number after /li/ in the list URL.
CLICKUP_API_TOKEN=pk_your_personal_token
CLICKUP_LIST_ID=901100200300
# Recommended: ID of a Text custom field named SKU on that list (GET /api/v2/list/{list_id}/field)
CLICKUP_SKU_FIELD_ID=
# Optional: ClickUp user IDs for new tasks, separated by commas
CLICKUP_ASSIGNEE_IDS=
# Optional, defaults shown. Set CLICKUP_TAG=none for no tag.
CLICKUP_TAG=low-stock
CLICKUP_CLOSED_STATUS=complete
CLICKUP_RATE_LIMIT_WAIT_SECONDS=60

# Run Now webhook: send this in the X-Run-Now-Secret header. Without it, Run Now refuses every call.
RUN_NOW_SECRET=make-up-a-long-random-string
# When the daily check runs (n8n's time zone). Default 7:00 every day.
STOCK_CHECK_CRON=0 7 * * *

# Optional: Slack incoming webhook for the digest and the error alerts. Leave empty to skip Slack.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Self-hosted n8n must allow $env access in nodes
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
